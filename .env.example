# ─── TraFix Ortam Değişkenleri ─────────────────────────────────────────────
# Bu dosyayı .env olarak kopyalayın ve değerleri doldurun:
#   cp .env.example .env

# Model versiyonu: v2 | v3 | simple | v5 (varsayılan: v2)
TRAFIX_MODEL_VERSION=v2

# ─── PostgreSQL Bağlantısı ─────────────────────────────────────────────────
# Aşağıdaki değerleri kendi PostgreSQL kurulumunuza göre düzenleyin.
# Varsayılan değerler yerel kurulum için genellikle yeterlidir.

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=trafix
POSTGRES_USER=postgres
POSTGRES_PASSWORD=alpbaba
